<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1920 1080" preserveAspectRatio="xMidYMid slice" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
  <defs>
    <linearGradient id="sky" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#0b2a4a"/>
      <stop offset="0.55" stop-color="#1b5e8a"/>
      <stop offset="1" stop-color="#4fa3c7"/>
    </linearGradient>
    <radialGradient id="glow" cx="0.78" cy="0.22" r="0.45">
      <stop offset="0" stop-color="#bfe6f5" stop-opacity="0.75"/>
      <stop offset="1" stop-color="#bfe6f5" stop-opacity="0"/>
    </radialGradient>
  </defs>

  <rect width="1920" height="1080" fill="url(#sky)"/>
  <rect width="1920" height="1080" fill="url(#glow)"/>

  <!-- soft rolling layers -->
  <path d="M0 760 C 320 640, 640 860, 960 760 S 1600 640, 1920 760 V1080 H0 Z" fill="#0b2a4a" opacity="0.35"/>
  <path d="M0 850 C 360 740, 700 940, 1040 850 S 1640 760, 1920 860 V1080 H0 Z" fill="#0b2a4a" opacity="0.5"/>
  <path d="M0 950 C 400 880, 760 1020, 1120 950 S 1700 900, 1920 960 V1080 H0 Z" fill="#071b30" opacity="0.7"/>

  <!-- faint grid of dots -->
  <g fill="#ffffff" opacity="0.12">
    <circle cx="160" cy="140" r="3"/><circle cx="280" cy="220" r="2"/><circle cx="420" cy="120" r="3"/>
    <circle cx="560" cy="260" r="2"/><circle cx="700" cy="160" r="3"/><circle cx="860" cy="100" r="2"/>
    <circle cx="1000" cy="240" r="3"/><circle cx="1140" cy="140" r="2"/><circle cx="1300" cy="300" r="3"/>
    <circle cx="1460" cy="180" r="2"/><circle cx="1620" cy="120" r="3"/><circle cx="1760" cy="260" r="2"/>
    <circle cx="220" cy="420" r="2"/><circle cx="520" cy="480" r="3"/><circle cx="1240" cy="520" r="2"/>
    <circle cx="1560" cy="440" r="3"/><circle cx="1840" cy="520" r="2"/>
  </g>
</svg>
